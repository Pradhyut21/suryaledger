# Never prefix server secrets with VITE_. Copy to .env; never commit it.
HOST=127.0.0.1
PORT=8787
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_TOOL_TOKEN=
# Public HTTPS tunnel URL to this LOCAL demo, only if using live tool callbacks.
BOLNA_PUBLIC_BASE_URL=
# Only when opening the frontend through a tunnel; exact browser origin.
PUBLIC_ORIGIN=
