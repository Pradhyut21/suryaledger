    "evaluate": "node scripts/evaluate.mjs",
    "preview": "vite --host 127.0.0.1",
    "bolna:config": "node --env-file-if-exists=.env scripts/prepare-bolna.mjs"
  },
  "dependencies": {
    "@bolna/web-call": "^3.0.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^7.3.0"
  }
}
