{
  "name": "suryaledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice-led solar service records with traceable evidence and human review.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
